  "description": "Public WebMCP assistant and session wizard with visible agent changes and a human-controlled Perssua handoff.",
  "license": "MIT",
  "author": "MONTANO PRODUCTIONS B.V.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
